# .env.example

# Google API Key
GOOGLE_API_KEY= "your_google_api_key"

# Firebase Project ID
FIREBASE_PROJECT_ID= "your_firebase_project_id"

# ABHA Credentials
ABHA_CLIENT_ID= "your_abha_client_id"
ABHA_CLIENT_SECRET= "your_abha_client_secret"

# Other Configuration
OTHER_CONFIG= "your_other_config"